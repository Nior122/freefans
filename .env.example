# Public base URL of the deployed site (no trailing slash).
# Used by scripts/generate-sitemap.mjs to build absolute URLs in sitemap.xml / robots.txt.
# Cloudflare Pages -> Settings -> Environment variables -> Production:
#   SITE_URL = https://fansleak.pages.dev
SITE_URL=https://fansleak.pages.dev

# Public Telegram username (without "@") of the contact bot opened by each
# profile's Message / Request contact button. This is a public identifier,
# not a secret. When unset, the site falls back to the default in
# components/ProfilePage.tsx. Set the same value in Cloudflare Pages if the
# bot username ever changes.
# VITE_TELEGRAM_BOT_USERNAME=YourBotUsername
