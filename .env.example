# Public base URL of the deployed site (no trailing slash).
# Used by scripts/generate-sitemap.mjs to build absolute URLs in sitemap.xml / robots.txt.
# Cloudflare Pages -> Settings -> Environment variables -> Production:
#   SITE_URL = https://fansleak.pages.dev
SITE_URL=https://fansleak.pages.dev

# Public Telegram username (without "@") of the contact bot opened by each
# profile's Message / Request contact button. This is a public identifier,
# not a secret. When unset, the site falls back to the default in
# components/ProfilePage.tsx. Set the same value in Cloudflare Pages if the
# bot username ever changes.
# VITE_TELEGRAM_BOT_USERNAME=YourBotUsername

# Website admin CMS (Cloudflare Pages). These are server-side Pages settings,
# not Vite variables. Do not put real secrets in this example file.
# Binding (Pages -> Settings -> Bindings): SITE_DB -> fansleak-site-cms
# Secrets (Pages -> Settings -> Environment variables):
#   ADMIN_USERNAME=choose-a-new-admin-username
#   ADMIN_PASSWORD=choose-a-strong-new-password
#   ADMIN_SESSION_SECRET=generate-at-least-32-random-characters
# Optional instead of ADMIN_PASSWORD:
#   ADMIN_PASSWORD_SHA256=<sha256-hex-of-admin-password>
# Optional website CMS tuning:
#   ADMIN_SESSION_HOURS=8
#   SCRAPER_MAX_ITEMS=300
#   SCRAPER_MAX_PAGES=3
#   SCRAPER_USER_AGENT=Mozilla/5.0 FansLeakAdminImporter/1.0
