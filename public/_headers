# Cloudflare Pages response headers.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# HTML shell: always revalidate so a new deploy (and the Search Console
# verification meta tag) is served immediately instead of a cached copy.
/
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: all

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: all

/profile/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: index, follow

/search
  Cache-Control: public, max-age=0, must-revalidate

/hashtags
  Cache-Control: public, max-age=0, must-revalidate

/more
  Cache-Control: public, max-age=0, must-revalidate

# Crawling aids: correct types so Search Console accepts them as sitemap/robots.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Content-Disposition: inline
  Cache-Control: public, max-age=1800

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=1800

# Private app routes never belong in the index.
/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store

/auth
  X-Robots-Tag: noindex, nofollow

/auth/*
  X-Robots-Tag: noindex, nofollow

/favorites
  X-Robots-Tag: noindex, nofollow

/favorites/*
  X-Robots-Tag: noindex, nofollow

/assets/*
  Cache-Control: public, max-age=31536000, immutable
