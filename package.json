{
  "name": "fansleak",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prebuild": "node scripts/generate-contact-catalogue.mjs && node scripts/generate-sitemap.mjs",
    "server": "tsx server.ts",
    "start": "node scripts/start.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "postbuild": "node scripts/prerender.mjs && node scripts/check-seo.mjs",
    "prerender": "node scripts/prerender.mjs",
    "check-seo": "node scripts/check-seo.mjs",
    "add-profile": "node scripts/add-profile.mjs",
    "test": "node --test tests/contact-catalogue.test.mjs && npx tsx --test tests/contact-bot.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "lucide-react": "^0.263.1",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "tsx": "^4.21.0",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "overrides": {
    "tar": "7.5.22",
    "shell-quote": "1.9.0",
    "protobufjs": "7.5.9"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vercel/node": "^5.5.26",
    "@vitejs/plugin-react": "^4.7.0",
    "canvas": "^3.2.1",
    "node-fetch": "^3.3.2",
    "playwright-chromium": "^1.58.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
